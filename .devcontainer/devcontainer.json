// For format details, see https://aka.ms/devcontainer.json.
// For config options, see the README at:
// https://github.com/devcontainers/templates/tree/main/src/javascript-node
{
  "name": "Node.js",

  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",

  "features": {
    "ghcr.io/devcontainers-contrib/features/vue-cli:2": {}
  },

  "forwardPorts": [8080],
  "appPort": ["8080:8080"],

  "remoteEnv": {
    "PATH": "${containerEnv:HOME}/.opencode/bin:${containerEnv:PATH}"
  },

  "postCreateCommand": "if ! command -v curl >/dev/null 2>&1; then sudo apt-get update && sudo apt-get install -y curl ca-certificates; fi && if ! command -v opencode >/dev/null 2>&1 && [ ! -x \"$HOME/.opencode/bin/opencode\" ]; then curl -fsSL https://opencode.ai/install | bash; fi && grep -qxF 'export PATH=\"$HOME/.opencode/bin:$PATH\"' \"$HOME/.bashrc\" || echo 'export PATH=\"$HOME/.opencode/bin:$PATH\"' >> \"$HOME/.bashrc\" && \"$HOME/.opencode/bin/opencode\" --version || true"

  // Use 'postCreateCommand' to run commands after the container is created.
  // "postCreateCommand": "yarn install",

  // Configure tool-specific properties.
  // "customizations": {},

  // Uncomment to connect as root instead.
  // "remoteUser": "root"
}